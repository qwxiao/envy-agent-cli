# 复制为 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略——凭证不要提交进仓库。

# 默认用哪个厂商（可选，缺省 deepseek）
PROVIDER=deepseek

# 每个厂商一个凭证键：<厂商名>_API_KEY
# 厂商的默认入口与模型名见 src/envy_agent_cli/llm/adapter.py 的 PROVIDER_DEFAULTS
DEEPSEEK_API_KEY=sk-your-key-here
GLM_API_KEY=your-key-here
# OPENAI_API_KEY=sk-...

# 按厂商覆盖默认值（可选）：
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GLM_MODEL=glm-5.3-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
